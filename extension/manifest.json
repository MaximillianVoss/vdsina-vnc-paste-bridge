{
  "manifest_version": 3,
  "name": "VDSina VNC Paste Bridge",
  "version": "1.1.1",
  "minimum_chrome_version": "111",
  "description": "Проверенная локальная очередь ASCII с пакетами до 256, Stop и отдельным Enter.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cp.vdsina.ru/static/novnc/start.html",
        "https://cp.vdsina.ru/static/novnc/start.html?*"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "world": "MAIN",
      "js": [
        "core-main.js",
        "provider.js",
        "main-bridge.js"
      ]
    },
    {
      "matches": [
        "https://cp.vdsina.ru/static/novnc/start.html",
        "https://cp.vdsina.ru/static/novnc/start.html?*"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "world": "ISOLATED",
      "css": [
        "content.css"
      ],
      "js": [
        "core.js",
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Вставка в VNC — панель на странице консоли",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
